MONGO_URL_SCRAPPING=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
MONGO_DBNAME_SCRAPPING=spark_erp
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=30d
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# Optional translation provider settings. The defaults work without a key.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_CONTACT_EMAIL=
MYMEMORY_API_KEY=
